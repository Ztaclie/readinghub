{
  "ConnectionStrings": {
    "Database": ""
  },
  "Auth": {
    "JwtSigningKey": "",
    "JwtIssuer": "readinghub",
    "JwtAudience": "readinghub-extension",
    "AccessTokenMinutes": 15,
    "SessionIdleDays": 14,
    "SessionAbsoluteDays": 30,
    "LoginPermitLimit": 10
  },
  "Cors": {
    "WebOrigin": "http://localhost:5173"
  },
  "DataProtection": {
    "KeyPath": "keys"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
